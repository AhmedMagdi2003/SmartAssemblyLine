# Local dashboard address on the factory PC
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Quick tunnel mode uses a temporary trycloudflare.com URL.
# Leave CLOUDFLARE_TUNNEL_TOKEN empty for quick mode.

# For a stable public hostname, create a named Cloudflare Tunnel and set:
# CLOUDFLARE_TUNNEL_TOKEN=your-token-here
# Then run the tunnel script again.
CLOUDFLARE_TUNNEL_TOKEN=
