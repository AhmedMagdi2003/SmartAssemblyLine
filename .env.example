DATABASE_URL=postgresql://smartassembly:smartassembly@localhost:5433/smart_assembly
# Optional shortcut. If DATABASE_URL is set, it takes priority.
# SMART_ASSEMBLY_DB_BACKEND=postgres
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=factory/assembly/boxes
MQTT_CONTROL_HOST=deltapi
MQTT_CONTROL_PORT=1883
MQTT_CONTROL_TOPIC=phone/test
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CONTROL_USERNAME=
# MQTT_CONTROL_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_KEEPALIVE=60
# MQTT_CONTROL_TLS_ENABLED=false
# MQTT_CONTROL_KEEPALIVE=60

# Vision frame source.
# Default delivery mode: Raspberry Pi camera streamed by ffmpeg over TCP MJPEG.
# Run this on the Raspberry Pi:
# ffmpeg -f v4l2 -input_format mjpeg -framerate 24 -video_size 640x480 -i /dev/video0 -c:v copy -f mjpeg "tcp://0.0.0.0:1234?listen&tcp_nodelay=1"
#
# If the project runs on the PC, deltapi must resolve to the Raspberry Pi.
# If Windows cannot resolve deltapi, try tcp://deltapi.local:1234 or use the Pi IP.
VISION_SOURCE=pi_stream
PI_CAMERA_STREAM_URL=tcp://deltapi:1234?tcp_nodelay=1
VISION_VIDEO_PATH=data/videos/videoproject 1.mp4
VISION_TARGET_FPS=24
VISION_DISPLAY=true
VISION_MAX_MISSED_FRAMES=90
# OpenCV displays camera/video frames at their original size and aspect ratio.

# Optional Raspberry Pi / mechanical-system serial control.
# Windows example: COM3
# Linux / Raspberry Pi bridge example: /dev/ttyUSB0
# Leave MECHANICAL_SERIAL_PORT empty to disable serial commands.
MECHANICAL_SERIAL_PORT=
MECHANICAL_SERIAL_BAUDRATE=115200
MECHANICAL_SERIAL_TIMEOUT_SEC=2
