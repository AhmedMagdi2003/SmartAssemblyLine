<?xml version="1.0"?>
<package format="3">
  <name>smart_assembly_camera_bridge</name>
  <version>0.1.0</version>
  <description>ROS2 bridge package for Raspberry Pi camera streaming to the Smart Assembly Line PC.</description>
  <maintainer email="you@example.com">Smart Assembly Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
